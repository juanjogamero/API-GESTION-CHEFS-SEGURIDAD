# Entorno de desarrollo local (no uses estas credenciales fuera de tu equipo)
DB_URL=jdbc:postgresql://localhost:5432/simulacro_db
DB_USER=postgres
DB_PASSWORD=postgres
# Genera un secreto propio: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Provisión opcional del primer administrador, en local:
APP_ADMIN_USER=
APP_ADMIN_PASSWORD=
